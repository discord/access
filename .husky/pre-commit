#!/bin/sh
# Git runs this hook because the `prepare` script in package.json, which every
# `npm install` and `npm ci` runs, sets core.hooksPath to the relative `.husky`.
# Git resolves a relative hooks path against the root of whichever worktree is
# committing, so one shared setting reaches each worktree's own tracked copy of
# this file, including worktrees where npm never ran. Git also runs hooks with
# cwd at that root, so lint-staged sees the right files. Keep this hook free of
# $0-relative paths and of anything generated by `npm install`.
#
# Set HUSKY=0 to skip the hook for one commit.
[ "$HUSKY" = "0" ] && exit 0

# A worktree gets the hook without having its own node_modules. Stop there
# rather than letting npx fetch whatever lint-staged the registry serves today.
if [ ! -x node_modules/.bin/lint-staged ]; then
  echo "pre-commit: lint-staged is not installed in this worktree." >&2
  echo "Run \`npm ci\` here, or set HUSKY=0 to commit without the hook." >&2
  exit 1
fi

npx --no lint-staged
